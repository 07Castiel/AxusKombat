# =============================================================================
# Variáveis de ambiente do Axus Kombat
#
# Este arquivo é a lista completa do que o código lê. Levantado com:
#   grep -rhoE "process\.env\.[A-Z_0-9]+" src/
#
# ONDE CONFIGURAR: Lovable > Cloud > Secrets. O `.env` do repositório só carrega
# os valores publicáveis do Supabase, que o próprio Lovable gera — NUNCA
# acrescente segredo nele: o arquivo é versionado.
#
# Cada variável abaixo diz o que quebra na ausência dela. Sem isso, uma
# variável esquecida só aparece como erro em produção.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Gerados pelo Lovable Cloud. As VITE_* vão para o bundle do navegador e são
# públicas por natureza; as sem prefixo ficam no servidor.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...            # chave anon — pública, vai no bundle
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Chave de serviço: ignora RLS por completo. Só existe no servidor, e só é usada
# em arquivos *.server.ts e nas server functions.
# Sem ela: toda server function que usa supabaseAdmin falha na primeira chamada.
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# --- Cron ---------------------------------------------------------------------
# Segredo dos hooks chamados pelo pg_cron.
#
# Antes esses endpoints comparavam com SUPABASE_PUBLISHABLE_KEY — a mesma chave
# que vai no bundle do navegador. Na prática eram públicos: dava para disparar o
# worker de WhatsApp em laço para todas as academias.
#
# Sem CRON_SECRET o código volta ao comportamento antigo e grita no log a cada
# chamada. Gere um valor longo e aleatório e atualize os jobs em Cloud > Jobs
# para mandarem o header `x-cron-secret`.
CRON_SECRET=troque-por-um-valor-longo-e-aleatorio


# --- Painel do SaaS (admin mestre) --------------------------------------------
# Credenciais do /admin-master, que enxerga TODAS as academias.
# Sem elas: masterLogin recusa qualquer tentativa.
MASTER_ADMIN_EMAIL=voce@exemplo.com
MASTER_ADMIN_PASSWORD=

# Chave que assina o token de sessão do painel mestre.
# Sem ela o token é assinado com a própria MASTER_ADMIN_PASSWORD — a senha vira
# chave criptográfica, e quem obtiver um token pode atacá-lo offline para
# recuperá-la. Use um valor distinto da senha.
MASTER_TOKEN_SECRET=troque-por-um-valor-longo-e-aleatorio


# --- Stripe -------------------------------------------------------------------
# Sem STRIPE_SECRET_KEY: o checkout não abre.
# Sem STRIPE_WEBHOOK_SECRET: o webhook devolve 400 e nenhuma assinatura ativa.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Um price id por plano e período. Sem o correspondente, o checkout daquele
# plano falha com "Price ID não configurado".
STRIPE_PRICE_START_MONTHLY=price_...
STRIPE_PRICE_START_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...
STRIPE_PRICE_ELITE_ANNUAL=price_...


# --- WhatsApp (Evolution API) --------------------------------------------------
# Sem estas duas: conectar o WhatsApp e enviar qualquer mensagem falha.
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=


# --- Aplicação -----------------------------------------------------------------
# Origem pública do app. Usada para montar as URLs de retorno do checkout e para
# liberar CORS no registro de visitas.
#
# Sem ela o servidor cai na origem da própria requisição, o que funciona — mas
# defina explicitamente em produção, para o retorno do Stripe não depender do
# header que o cliente mandou.
APP_URL=https://app.exemplo.com


# --- Worker de notificações (opcionais) ----------------------------------------
# Ajustam o ritmo de envio. Os padrões dão ~480 mensagens por hora, folga larga
# para uma academia, sem a rajada que chama atenção do WhatsApp.
NOTIF_LOTE=120              # agendadas por rodada (padrão 120)
NOTIF_LOTE_RETRY=60         # reenvios por rodada (padrão 60)
NOTIF_INTERVALO_MS=250      # pausa entre um envio e o próximo (padrão 250)
